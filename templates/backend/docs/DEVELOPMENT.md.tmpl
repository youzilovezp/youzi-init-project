## 8. 添加新的业务模块

以「文章」模块为例：

### 8.1 创建模型（`app/models/article.py`）

```python
from sqlalchemy import String, Text
from sqlalchemy.orm import Mapped, mapped_column
from app.models.base_class import Base, TimestampMixin


class Article(Base, TimestampMixin):
    __tablename__ = "articles"

    id: Mapped[int] = mapped_column(primary_key=True, autoincrement=True)
    title: Mapped[str] = mapped_column(String(200), nullable=False)
    content: Mapped[str | None] = mapped_column(Text)
    author_id: Mapped[int] = mapped_column(index=True)
```

注册到 `app/models/__init__.py`：

```python
from app.models.article import Article
__all__ = [..., "Article"]
```

### 8.2 创建 Schema（`app/schemas/article.py`）

```python
from pydantic import BaseModel, ConfigDict


class ArticleBase(BaseModel):
    title: str
    content: str | None = None


class ArticleCreate(ArticleBase):
    pass


class ArticleUpdate(BaseModel):
    title: str | None = None
    content: str | None = None


class ArticleOut(ArticleBase):
    id: int
    author_id: int
    model_config = ConfigDict(from_attributes=True)
```

### 8.3 创建 CRUD（`app/crud/article.py`）

```python
from app.crud.base import CRUDBase
from app.models.article import Article
from app.schemas.article import ArticleCreate, ArticleUpdate

article_crud = CRUDBase[Article, ArticleCreate, ArticleUpdate](Article)
```

### 8.4 创建 Endpoint（`app/api/v1/endpoints/articles.py`）

```python
from fastapi import APIRouter
from app.api.deps import CurrentUser, SessionDep
from app.core.exceptions import NotFoundError
from app.crud.article import article_crud
from app.schemas.common import ResponseModel
from app.schemas.article import ArticleCreate, ArticleOut, ArticleUpdate

router = APIRouter()


@router.get("", response_model=ResponseModel[list[ArticleOut]])
async def list_articles(db: SessionDep, _: CurrentUser):
    items = await article_crud.list_all(db)
    return ResponseModel(data=[ArticleOut.model_validate(a) for a in items])


@router.post("", response_model=ResponseModel[ArticleOut])
async def create_article(db: SessionDep, _: CurrentUser, payload: ArticleCreate):
    obj = await article_crud.create(db, payload)
    return ResponseModel(data=ArticleOut.model_validate(obj))


# ... 更多接口
```

注册路由（`app/api/v1/router.py`）：

```python
from app.api.v1.endpoints import articles

api_router.include_router(articles.router, prefix="/articles", tags=["文章管理"])
```

### 8.5 生成迁移

```bash
alembic revision --autogenerate -m "add articles table"
alembic upgrade head
```

