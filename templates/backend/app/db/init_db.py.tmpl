"""
数据库初始化：智能维护表结构 + 种子数据。

设计目标：让"非技术"用户零配置即可启动。

启动行为矩阵（取决于 settings 中的开关）：

| 状态                | AUTO_CREATE_TABLES | AUTO_MIGRATE | 行为                                     |
|--------------------|--------------------|--------------|------------------------------------------|
| 首次启动（无表）| ✅                 | ✅                 | create_all 建表 → alembic stamp head → 种子 |
| 首次启动（无表）| ✅                 | ❌                 | create_all 建表 → 种子                       |
| 后续启动（有表）| -                  | ✅                 | alembic upgrade head → 种子                  |
| 后续启动（有表）| -                  | ❌                 | 不动表结构 → 种子                             |
| 生产环境（关掉所有）| ❌                 | ❌                 | 完全不维护表结构，由运维手工跑 alembic           |

任何步骤失败都只记录警告，**不会阻塞应用启动**。
"""
import asyncio
from pathlib import Path

from loguru import logger
from sqlalchemy import inspect, select

from app.core.config import settings
from app.core.security import hash_password
from app.db.session import async_session, engine
from app.models.base_class import Base  # noqa: F401  触发模型注册
from app.models.user import User
from app.models.role import Role
from app.models.menu import Menu  # noqa: F401  触发模型注册


# ---------- 表操作 ----------
async def create_tables() -> None:
    """使用 SQLAlchemy metadata 自动建表。"""
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)
    logger.info("✅ 数据库表已通过 metadata.create_all 创建")


async def has_alembic_version_table() -> bool:
    """检查是否存在 alembic_version 表（用于判断是否首次启动）。"""
    def _check(sync_conn) -> bool:
        inspector = inspect(sync_conn)
        return inspector.has_table("alembic_version")

    async with engine.connect() as conn:
        return await conn.run_sync(_check)


# ---------- Alembic Python API（不依赖 PATH） ----------
def _find_alembic_ini() -> Path:
    """根据当前工作目录定位 alembic.ini。

    - admin 模式：backend/alembic.ini
    - server 模式：./alembic.ini
    """
    candidates = [Path.cwd() / "alembic.ini", Path.cwd() / "backend" / "alembic.ini"]
    for c in candidates:
        if c.exists():
            return c
    # 兜底：项目根目录
    return candidates[0]


def _run_alembic_sync(*args: str) -> tuple[int, str, str]:
    """使用 Alembic Python API 调用命令（不依赖 PATH 中的 alembic 可执行文件）。"""
    # 在子线程中调用，避免 alembic 把日志污染到主进程
    from alembic.config import Config
    from alembic import command

    try:
        ini_path = _find_alembic_ini()
        cfg = Config(str(ini_path))
        cfg.set_main_option("sqlalchemy.url", settings.DATABASE_URL)
        func_name, *rest = args
        getattr(command, func_name)(cfg, *rest)
        return (0, "", "")
    except SystemExit as exc:
        # alembic 在错误时调用 sys.exit()
        return (int(exc.code) if isinstance(exc.code, int) else 1, "", "alembic exited")
    except Exception as exc:
        return (1, "", str(exc))


async def _alembic_upgrade_head() -> None:
    """异步执行 alembic upgrade head（在线程池中跑，避免阻塞事件循环）。"""
    loop = asyncio.get_event_loop()
    code, stdout, stderr = await loop.run_in_executor(None, _run_alembic_sync, "upgrade", "head")
    if code == 0:
        logger.info("✅ Alembic 迁移完成")
    else:
        logger.warning(f"⚠️ Alembic 升级失败：{stderr.strip() or stdout.strip()}")


async def _alembic_stamp_head() -> None:
    """标记当前数据库 schema 为 head（首次启动 create_all 后使用）。"""
    loop = asyncio.get_event_loop()
    code, stdout, stderr = await loop.run_in_executor(
        None, _run_alembic_sync, "stamp", "head"
    )
    if code == 0:
        logger.info("✅ 已将数据库标记为 head 版本")
    else:
        logger.warning(f"⚠️ Alembic stamp 失败：{stderr.strip() or stdout.strip()}")


# ---------- 种子数据 ----------
async def create_initial_data() -> None:
    """插入种子数据：默认角色 + 默认管理员。"""
    async with async_session() as session:
        # 默认角色
        admin_role = await session.get(Role, 1)
        if admin_role is None:
            admin_role = Role(id=1, name="超级管理员", code="admin", remark="系统内置")
            session.add(admin_role)
            await session.commit()

        # 默认管理员
        stmt = select(User).where(User.username == settings.INITIAL_ADMIN_USERNAME)
        result = await session.execute(stmt)
        admin = result.scalar_one_or_none()
        if admin is None:
            admin = User(
                username=settings.INITIAL_ADMIN_USERNAME,
                email=settings.INITIAL_ADMIN_EMAIL,
                password_hash=hash_password(settings.INITIAL_ADMIN_PASSWORD),
                is_active=True,
                is_superuser=True,
                role_id=1,
                nickname="超级管理员",
            )
            session.add(admin)
            await session.commit()
            logger.info(
                f"✅ 默认管理员已创建: {settings.INITIAL_ADMIN_USERNAME} / {settings.INITIAL_ADMIN_PASSWORD}"
            )


# ---------- 主入口 ----------
async def init_db() -> None:
    """启动时调用：根据数据库状态自动决定如何维护表结构。"""
    auto_create = getattr(settings, "AUTO_CREATE_TABLES", True)
    auto_migrate = getattr(settings, "AUTO_MIGRATE", True)
    auto_seed = getattr(settings, "AUTO_SEED_DATA", True)

    if not auto_create and not auto_migrate and not auto_seed:
        logger.info("⏭️  数据库自动维护已全部关闭，跳过")
        return

    try:
        is_first_run = not await has_alembic_version_table()
    except Exception as exc:
        logger.warning(f"⚠️ 无法检查 alembic 状态，降级为 create_all 模式: {exc}")
        is_first_run = True

    if is_first_run:
        logger.info("📦 首次启动：自动建表 + stamp baseline")
        if auto_create:
            try:
                await create_tables()
            except Exception as exc:
                logger.error(f"❌ create_all 失败: {exc}")
        try:
            await _alembic_stamp_head()
        except Exception as exc:
            logger.warning(f"⚠️ alembic stamp 失败（可忽略，不影响启动）: {exc}")
    else:
        logger.info("🔄 检测到已有 schema，执行迁移")
        if auto_migrate:
            try:
                await _alembic_upgrade_head()
            except Exception as exc:
                logger.warning(f"⚠️ alembic upgrade 失败（可忽略，不影响启动）: {exc}")

    if auto_seed:
        try:
            await create_initial_data()
        except Exception as exc:
            logger.warning(f"⚠️ 种子数据写入失败: {exc}")
