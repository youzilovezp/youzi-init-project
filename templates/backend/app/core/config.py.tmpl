"""
应用配置。

设计原则：
    1. 所有可配置项集中在 Settings 类
    2. 从环境变量 / .env 文件加载（pydantic-settings）
    3. 业务代码中只通过 settings.xxx 访问，禁止直接读环境变量

完整配置项说明请参阅 docs/配置说明.md。
"""
import json
from functools import lru_cache
from typing import Annotated, Any, Literal

from pydantic import BeforeValidator, Field
from pydantic_settings import BaseSettings, SettingsConfigDict


def _parse_cors_origins(value: Any) -> list[str]:
    """兼容三种写法：
    1. JSON 数组：`["http://a","http://b"]`
    2. 逗号分隔：`http://a,http://b`
    3. 已经是 list[str]
    """
    if isinstance(value, list):
        return [str(v).strip() for v in value if str(v).strip()]
    if isinstance(value, str):
        s = value.strip()
        if not s:
            return []
        if s.startswith("["):
            try:
                parsed = json.loads(s)
                if isinstance(parsed, list):
                    return [str(v).strip() for v in parsed if str(v).strip()]
            except json.JSONDecodeError:
                pass
        # 逗号分隔
        return [v.strip() for v in s.split(",") if v.strip()]
    return [str(value)]


class Settings(BaseSettings):
    """全局配置。"""

    # ---------- 应用基础 ----------
    APP_NAME: str = "{{ project_title }}"
    APP_DESCRIPTION: str = "{{ project_title }} 管理系统后端 API"
    APP_ENV: Literal["dev", "test", "prod"] = "dev"
    DEBUG: bool = True
    API_V1_PREFIX: str = "/api/v1"

    # ---------- 安全 ----------
    SECRET_KEY: str = Field(..., description="JWT 签名密钥，请使用 openssl rand -hex 32 生成")
    # 限定算法集合，禁止被外部 .env 改成 'none'
    JWT_ALGORITHM: Literal["HS256", "HS384", "HS512"] = "HS256"
    # 单一过期时间源：单位分钟；ACCESS_TOKEN_EXPIRE_SECONDS 由其派生，避免双字段不一致
    JWT_EXPIRE_MINUTES: int = 60 * 24  # 24 小时

    @property
    def ACCESS_TOKEN_EXPIRE_SECONDS(self) -> int:
        """供前端展示的过期时间（秒），派生自 JWT_EXPIRE_MINUTES。"""
        return self.JWT_EXPIRE_MINUTES * 60

    # ---------- 服务监听 ----------
    HOST: str = "0.0.0.0"
    PORT: int = {{ backend_port }}
    WORKERS: int = 1

    # ---------- 数据库 ----------
    DB_DRIVER: str = "{{ db_driver }}"  # asyncpg / aiomysql
    POSTGRES_HOST: str = "localhost"
    POSTGRES_PORT: int = {{ postgres_port }}
    POSTGRES_USER: str = "{{ project_name }}"
    POSTGRES_PASSWORD: str = "{{ db_password }}"
    POSTGRES_DB: str = "{{ project_name }}"
    MYSQL_HOST: str = "localhost"
    MYSQL_PORT: int = 3306
    MYSQL_USER: str = "{{ project_name }}"
    MYSQL_PASSWORD: str = "{{ db_password }}"
    MYSQL_DB: str = "{{ project_name }}"
    DB_ECHO: bool = False
    DB_POOL_SIZE: int = 10
    DB_MAX_OVERFLOW: int = 20

    # Alembic 用同步 URL（独立引擎，避免异步 greenlet 冲突）
    ALEMBIC_SYNC_URL: str = (
        "postgresql+psycopg2://{{ project_name }}:{{ db_password }}@localhost:{{ postgres_port }}/{{ project_name }}"
    )

    @property
    def DATABASE_URL(self) -> str:
        if self.DB_DRIVER in ("asyncpg", "psycopg2"):
            return (
                f"postgresql+asyncpg://{self.POSTGRES_USER}:{self.POSTGRES_PASSWORD}"
                f"@{self.POSTGRES_HOST}:{self.POSTGRES_PORT}/{self.POSTGRES_DB}"
            )
        return (
            f"mysql+aiomysql://{self.MYSQL_USER}:{self.MYSQL_PASSWORD}"
            f"@{self.MYSQL_HOST}:{self.MYSQL_PORT}/{self.MYSQL_DB}"
        )

    @property
    def ALEMBIC_DATABASE_URL(self) -> str:
        """同步 URL——alembic 走同步路径，使用 psycopg2/mysqlclient。"""
        return self.ALEMBIC_SYNC_URL
{% if enable_redis %}
    # ---------- Redis ----------
    REDIS_HOST: str = "localhost"
    REDIS_PORT: int = {{ redis_port }}
    REDIS_DB: int = 0
    REDIS_PASSWORD: str | None = None

    @property
    def REDIS_URL(self) -> str:
        auth = f":{self.REDIS_PASSWORD}@" if self.REDIS_PASSWORD else ""
        return f"redis://{auth}{self.REDIS_HOST}:{self.REDIS_PORT}/{self.REDIS_DB}"
{% endif %}
{% if enable_rabbitmq %}
    # ---------- RabbitMQ ----------
    RABBITMQ_HOST: str = "localhost"
    RABBITMQ_PORT: int = {{ rabbitmq_port }}
    RABBITMQ_USER: str = "{{ project_name }}"
    RABBITMQ_PASSWORD: str = "{{ rabbitmq_password }}"
    RABBITMQ_VHOST: str = "/"

    @property
    def RABBITMQ_URL(self) -> str:
        return (
            f"amqp://{self.RABBITMQ_USER}:{self.RABBITMQ_PASSWORD}"
            f"@{self.RABBITMQ_HOST}:{self.RABBITMQ_PORT}/{self.RABBITMQ_VHOST}"
        )
{% endif %}
{% if enable_minio %}
    # ---------- MinIO / 对象存储 ----------
    MINIO_ENDPOINT: str = "localhost:{{ minio_api_port }}"
    MINIO_ACCESS_KEY: str = "{{ minio_user }}"
    MINIO_SECRET_KEY: str = "{{ minio_password }}"
    MINIO_BUCKET: str = "{{ project_name }}"
    MINIO_SECURE: bool = False
{% endif %}
{% if enable_celery %}
    # ---------- Celery ----------
    CELERY_BROKER_URL: str | None = None  # 默认与 REDIS_URL 一致
    CELERY_RESULT_BACKEND: str | None = None
{% endif %}
    # ---------- CORS ----------
    # 兼容 JSON 数组、逗号分隔、已是 list 三种写法
    CORS_ORIGINS: Annotated[list[str], BeforeValidator(_parse_cors_origins)] = [
        "http://localhost:{{ frontend_port }}",
        "http://localhost:3000",
    ]

    # ---------- 日志 ----------
    LOG_LEVEL: str = "INFO"
    LOG_FORMAT: Literal["json", "text"] = "text"

    # ---------- 初始化 ----------
    INITIAL_ADMIN_USERNAME: str = "{{ admin_user }}"
    INITIAL_ADMIN_PASSWORD: str = "{{ admin_pass }}"
    INITIAL_ADMIN_EMAIL: str = "{{ admin_email }}"

    # ---------- 数据库自动维护（合并三开关为单 bool）----------
    # true: 首次启动 create_all + stamp head；后续启动 alembic upgrade + 种子补全
    # false: 完全不维护，由 ops 手工跑 alembic
    AUTO_INIT_DB: bool = True
    AUTO_SEED_DATA: bool = True

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=True,
        extra="ignore",
    )


@lru_cache
def get_settings() -> Settings:
    """单例获取配置对象。"""
    return Settings()


settings = get_settings()
