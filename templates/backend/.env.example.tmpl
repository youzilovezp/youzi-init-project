# ============================================
# {{ project_title }} 后端环境变量样例
# ============================================
# 复制为 .env 后修改；所有可配置项都在 app/core/config.py 中定义
# 注：init.py 生成时已经把 SECRET_KEY 改成随机 64 位 hex

# ---------- 应用基础 ----------
APP_NAME={{ project_title }}
APP_ENV=dev                       # dev / test / prod
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- 安全 ----------
# 生产环境必须使用：openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_RANDOM_HEX
JWT_ALGORITHM=HS256
# 单一过期时间源（分钟）；.env 中只配这一个字段
JWT_EXPIRE_MINUTES=1440
# ACCESS_TOKEN_EXPIRE_SECONDS 由 JWT_EXPIRE_MINUTES 派生，无需单独配置

# ---------- 服务监听 ----------
HOST=0.0.0.0
PORT={{ backend_port }}
WORKERS=1

# ---------- 数据库 ----------
# POSTGRES_HOST: 默认 `localhost`（uvicorn 在宿主机上跑）
# 如在 docker 容器内运行（docker compose exec），改成 `postgres`
POSTGRES_HOST=localhost
POSTGRES_PORT={{ postgres_port }}
POSTGRES_USER={{ project_name }}
POSTGRES_PASSWORD={{ db_password }}
POSTGRES_DB={{ project_name }}

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# 单独给 alembic 用的同步 URL（init_db.py 用 psycopg2 走同步路径）
ALEMBIC_SYNC_URL=postgresql+psycopg2://{{ project_name }}:{{ db_password }}@localhost:{{ postgres_port }}/{{ project_name }}
{% if enable_redis %}
# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT={{ redis_port }}
REDIS_DB=0
REDIS_PASSWORD=

{% endif %}
{% if enable_rabbitmq %}
# ---------- RabbitMQ ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT={{ rabbitmq_port }}
RABBITMQ_USER={{ project_name }}
RABBITMQ_PASSWORD={{ rabbitmq_password }}
RABBITMQ_VHOST=/

{% endif %}
{% if enable_celery %}
# ---------- Celery ----------
{% if enable_redis %}
CELERY_BROKER_URL=                # 留空则使用 REDIS_URL
CELERY_RESULT_BACKEND=            # 留空则使用 REDIS_URL
{%- else %}
CELERY_BROKER_URL=amqp://{{ project_name }}:{{ rabbitmq_password }}@localhost:{{ rabbitmq_port }}//
CELERY_RESULT_BACKEND=rpc://
{%- endif %}

{% endif %}
{% if enable_minio %}
# ---------- MinIO / 对象存储 ----------
MINIO_ENDPOINT=localhost:{{ minio_api_port }}
MINIO_ACCESS_KEY={{ minio_user }}
MINIO_SECRET_KEY={{ minio_password }}
MINIO_BUCKET={{ project_name }}
MINIO_SECURE=false

{% endif %}
# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:{{ frontend_port }}","http://localhost:3000"]

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text / json

# ---------- 初始化 ----------
INITIAL_ADMIN_USERNAME={{ admin_user }}
INITIAL_ADMIN_PASSWORD={{ admin_pass }}
INITIAL_ADMIN_EMAIL={{ admin_email }}

# ---------- 数据库自动维护 ----------
# 单 bool 控制：true = 首次启动 create_all，后续启动 alembic upgrade；false = 完全不维护
AUTO_INIT_DB=true
AUTO_SEED_DATA=true
