# ============================================
# {{ project_title }} 后端环境变量样例
# ============================================
# 复制为 .env 后修改；所有可配置项都在 app/core/config.py 中定义
# init.py 生成 .env 时 SECRET_KEY 等会自动用随机值替换，下面保留占位符方便阅读

# ============================================
# ⚠️ 首次启动后必须手动建迁移基线：
#    make db-migrate msg="init"
#    make db-upgrade
# 跳过这步会导致后续加模型生成空 migration、表永远建不出来！
# ============================================

# ---------- 应用基础 ----------
APP_NAME={{ project_title }}
APP_ENV=dev                       # dev / test / prod
DEBUG=false                       # dev 才开 true,prod 必须 false
API_V1_PREFIX=/api/v1

# ---------- 安全 ----------
# 生产环境必须使用：openssl rand -hex 32
SECRET_KEY=__SECRET_KEY__   # init.py 替换为 64 hex(必填)
JWT_ALGORITHM=HS256
# 短期 token：60 分钟。配合 /auth/refresh 换长期 refresh（cookie）
JWT_EXPIRE_MINUTES=60

# ---------- 服务监听 ----------
HOST=0.0.0.0
PORT={{ backend_port }}
WORKERS=1

# ---------- 数据库 ----------
# 默认 `localhost`（uvicorn 跑在宿主机，连本机 docker compose 暴露的端口）
# 若后端跑在 docker 容器内，改 `postgres`（compose service name）
POSTGRES_HOST=localhost
POSTGRES_PORT={{ postgres_port }}
POSTGRES_USER={{ project_name }}
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB={{ project_name }}

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 防止长连接被 PG / NAT 静默断开
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT={{ redis_port }}
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- CORS ----------
# 生产环境必须显式列出可信域名（逗号分隔），留空 = 拒绝所有跨域
CORS_ORIGINS=["http://localhost:{{ frontend_port }}"]
# 生产环境必须配置为真实域名
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]   # ⚠️ 生产必须加你的真实域名,否则 nginx 部署直接 400 "Invalid host header"

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text / json（生产建议 json 进 ELK）

# ---------- 初始化 ----------
INITIAL_ADMIN_USERNAME={{ admin_user }}
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_RANDOM_PASSWORD
INITIAL_ADMIN_EMAIL={{ admin_email }}

# ---------- 数据库自动维护 ----------
# AUTO_INIT_DB: true = 首次启动 create_all + 后续 alembic upgrade
# AUTO_SEED_DATA: true = 创建默认 admin + 3 个 demo 用户（manager/alice/bob，密码 Demo@123）
# 生产环境必须设为 false（避免 Demo@123 进入生产 DB）
AUTO_INIT_DB=true
AUTO_SEED_DATA=true               # 生产必设 false（避免 Demo@123 等公开凭据进入生产 DB）
