# ============================================
# {{ project_title }} 后端环境变量样例
# ============================================
# 复制为 .env 后修改；所有可配置项都在 app/core/config.py 中定义

# ---------- 应用基础 ----------
APP_NAME={{ project_title }}
APP_ENV=dev                       # dev / test / prod
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- 安全 ----------
# 生产环境必须使用：openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_RANDOM_HEX
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# ---------- 服务监听 ----------
HOST=0.0.0.0
PORT=59001
WORKERS=1

# ---------- 数据库（按 DATABASE 选择启用） ----------
DATABASE=postgresql               # postgresql / mysql
DB_DRIVER={{ db_driver }}

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER={{ project_name }}
POSTGRES_PASSWORD={{ project_name }}
POSTGRES_DB={{ project_name }}

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER={{ project_name }}
MYSQL_PASSWORD={{ project_name }}
MYSQL_DB={{ project_name }}

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

{% if enable_redis -%}
# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

{% endif -%}
{% if enable_rabbitmq -%}
# ---------- RabbitMQ ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER={{ project_name }}
RABBITMQ_PASSWORD={{ project_name }}
RABBITMQ_VHOST=/

{% endif -%}
{% if enable_celery -%}
# ---------- Celery ----------
{% if enable_redis -%}
CELERY_BROKER_URL=                # 留空则使用 REDIS_URL
CELERY_RESULT_BACKEND=            # 留空则使用 REDIS_URL
{%- else -%}
CELERY_BROKER_URL=amqp://{{ project_name }}:{{ project_name }}@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
{%- endif %}

{% endif -%}
{% if enable_minio -%}
# ---------- MinIO / 对象存储 ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET={{ project_name }}
MINIO_SECURE=false

{% endif -%}
# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:59000","http://localhost:3000"]

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text / json

# ---------- 初始化 ----------
INITIAL_ADMIN_USERNAME=youzi
INITIAL_ADMIN_PASSWORD=youzi@123456
INITIAL_ADMIN_EMAIL=youzi@example.com

# ---------- 数据库自动维护 ----------
# 首次启动（无 alembic_version 表）：自动用 metadata.create_all 建表并 stamp head
# 后续启动（有 alembic_version 表）：自动跑 alembic upgrade head
# 生产环境可全部关闭，由运维手工跑 alembic
AUTO_CREATE_TABLES=true
AUTO_MIGRATE=true
AUTO_SEED_DATA=true
