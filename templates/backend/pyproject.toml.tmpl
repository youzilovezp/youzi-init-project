[project]
name = "{{ project_name }}-backend"
version = "0.1.0"
description = "{{ project_title }} 后端 API 服务"
requires-python = ">=3.11"
authors = [{ name = "{{ project_title }} Team" }]
readme = "后端说明.md"
dependencies = [
    # Web 框架
    "fastapi>=0.110.0",
    # 锁定到 0.30.x：0.31+ 在 lifespan asynccontextmanager 下 yield 后
    # "Application startup complete" 不打印，导致 uvicorn 一直返回 502。
    "uvicorn[standard]>=0.27.0,<0.31.0",

    # 数据库（锁定 postgresql；如需 MySQL 请自行添加 aiomysql）
    "sqlalchemy[asyncio]>=2.0.25",
    "alembic>=1.13.1",
    "asyncpg>=0.29.0",         # PostgreSQL 异步驱动
    "psycopg2-binary>=2.9.9",  # PostgreSQL 同步驱动（alembic 用）

    # 配置 / 安全
    "pydantic[email]>=2.6.0",   # [email] 提供 EmailStr 校验
    "pydantic-settings>=2.2.0",
    "python-jose[cryptography]>=3.3.0",
    "bcrypt>=4.0",            # 密码哈希（直接用 bcrypt，不再走 passlib）
    "python-multipart>=0.0.9",
{% if enable_redis %}
    # 缓存
    "redis>=5.0.1",
{% endif %}
{% if enable_celery %}
    # 异步任务
    "celery>=5.3.6",
    "flower>=2.0.0",
{% endif %}
{% if enable_minio %}
    # 对象存储
    "minio>=7.2.0",
{% endif %}
    # 工具
    "loguru>=0.7.2",
    "python-dotenv>=1.0.0",
    "httpx>=0.27.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0.0",
    "pytest-asyncio>=0.23.5",
    "pytest-cov>=4.1.0",
    "ruff>=0.3.0",
    "mypy>=1.8.0",
]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP", "B", "A", "C4", "DTZ", "PIE"]
ignore = ["E501"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app"]
