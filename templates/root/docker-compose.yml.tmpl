# 一键启动 {{ project_title }} 所有依赖
# 用法：docker compose up -d
# 配套 UI：adminer（端口 8080，看数据库）

services:
  postgres:
    image: postgres:16-alpine
    container_name: {{ project_name }}-postgres
    environment:
      POSTGRES_USER: {{ project_name }}
      POSTGRES_PASSWORD: {{ db_password }}
      POSTGRES_DB: {{ project_name }}
    ports:
      - "{{ postgres_port }}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ project_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  adminer:
    # 数据库管理 UI（非技术用户必备）：http://localhost:8080
    # 登录信息：PostgreSQL / {{ postgres_port }} / {{ project_name }} / {{ project_name }} / {{ db_password }}
    image: adminer:latest
    container_name: {{ project_name }}-adminer
    ports:
      - "8080:8080"
    environment:
      ADMINER_DEFAULT_SERVER: {{ project_name }}-postgres
      ADMINER_DESIGN: pepa-linha-dark
    depends_on:
      postgres:
        condition: service_healthy

{% if enable_redis %}
  redis:
    image: redis:7-alpine
    container_name: {{ project_name }}-redis
    ports:
      - "{{ redis_port }}:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
{% endif %}
{% if enable_rabbitmq %}
  rabbitmq:
    image: rabbitmq:3-management-alpine
    container_name: {{ project_name }}-rabbitmq
    environment:
      RABBITMQ_DEFAULT_USER: {{ project_name }}
      RABBITMQ_DEFAULT_PASS: {{ rabbitmq_password }}
    ports:
      - "{{ rabbitmq_port }}:5672"
      - "{{ rabbitmq_mgmt_port }}:15672"
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10
{% endif %}
{% if enable_minio %}
  minio:
    image: minio/minio:latest
    container_name: {{ project_name }}-minio
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: {{ minio_user }}
      MINIO_ROOT_PASSWORD: {{ minio_password }}
    ports:
      - "{{ minio_api_port }}:9000"
      - "{{ minio_console_port }}:9001"
    volumes:
      - minio_data:/data
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 10s
      timeout: 5s
      retries: 10
{% endif %}

volumes:
  postgres_data:
    name: {{ project_name }}_postgres_data
{% if enable_redis %}
  redis_data:
    name: {{ project_name }}_redis_data
{% endif %}
{% if enable_rabbitmq %}
  rabbitmq_data:
    name: {{ project_name }}_rabbitmq_data
{% endif %}
{% if enable_minio %}
  minio_data:
    name: {{ project_name }}_minio_data
{% endif %}
