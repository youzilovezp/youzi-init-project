# 一键启动 {{ project_title }} 所有依赖（含 backend）
# 用法：docker compose up -d
# 配套 UI：adminer（端口 8080，看数据库）

services:
  backend:
    build:
      # server 模式 backend 文件直接放项目根;admin 模式在 backend/ 子目录
      context: {% if only == 'admin' %}./backend{% else %}.{% endif %}
      dockerfile: docker/Dockerfile
    container_name: {{ project_name }}-backend
    env_file: {% if only == 'admin' %}./backend/.env{% else %}.env{% endif %}
    environment:
      # 在容器内，DB / Redis 用 compose service name
      POSTGRES_HOST: {{ project_name }}-postgres
{% if enable_redis %}
      REDIS_HOST: {{ project_name }}-redis
{% endif %}
    ports:
      - "{{ backend_port }}:8000"
    depends_on:
      postgres:
        condition: service_healthy
{% if enable_redis %}
      redis:
        condition: service_healthy
{% endif %}
    restart: unless-stopped
    healthcheck:
      # /readyz 含 DB ping，503 表示未就绪。slim 镜像无 wget，用 python urllib 替代。
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/readyz', timeout=3).status == 200 else 1)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

  postgres:
    image: postgres:16.4-alpine
    container_name: {{ project_name }}-postgres
    # admin 模式 .env 在 backend/，server 模式在根目录；env_file 让容器直接拿到 .env 里的所有 KEY=VAL
    env_file: {% if only == 'admin' %}./backend/.env{% else %}.env{% endif %}
    # POSTGRES_PASSWORD 由 env_file 提供——直接复用即可，不要在 environment 再写 ${POSTGRES_PASSWORD}，
    # 否则 docker compose 会做 compose-time 插值（读 shell env 而不是 env_file），结果是空字符串。
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-{{ project_name }}}
      POSTGRES_DB: ${POSTGRES_DB:-{{ project_name }}}
    ports:
      - "${POSTGRES_PORT:-{{ postgres_port }}}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-{{ project_name }}}"]
      interval: 10s
      timeout: 5s
      retries: 5

  adminer:
    # 数据库管理 UI（非技术用户必备）：http://localhost:8080
    # 登录：Server={{ project_name }}-postgres / Username=见 .env / Password=见 .env / Database=见 .env
    image: adminer:4.8.1
    container_name: {{ project_name }}-adminer
    ports:
      - "8080:8080"
    environment:
      ADMINER_DEFAULT_SERVER: {{ project_name }}-postgres
      ADMINER_DESIGN: pepa-linha-dark
    depends_on:
      postgres:
        condition: service_healthy

{% if enable_redis %}
  redis:
    image: redis:7.2-alpine
    container_name: {{ project_name }}-redis
    env_file: {% if only == 'admin' %}./backend/.env{% else %}.env{% endif %}
    # 显式 entrypoint=[sh, -c] 让容器内 sh 展开 $REDIS_PASSWORD（env_file 提供）
    # $$ 防 compose-time 插值（env_file 的值在 compose-time 不可见）。
    # 注意：直接用 command: "redis-server ..." 字符串形式会被新版 compose 智能
    # 解析为 exec 形式（按空格 split），$$ 不会被 sh 展开。
    entrypoint: ["sh", "-c"]
    command:
      - 'redis-server --requirepass "$$REDIS_PASSWORD" --appendonly yes'
    ports:
      - "${REDIS_PORT:-{{ redis_port }}}:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$$REDIS_PASSWORD\" ping | grep -q PONG"]
      interval: 10s
      timeout: 3s
      retries: 5
{% endif %}

volumes:
  postgres_data:
    name: {{ project_name }}_postgres_data
{% if enable_redis %}
  redis_data:
    name: {{ project_name }}_redis_data
{% endif %}
