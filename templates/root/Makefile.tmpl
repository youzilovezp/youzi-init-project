# {{ project_title }} 常用命令
# 设计原则：只保留非技术用户会用到的命令
{% if only == 'admin' %}
# ============== admin mode ==============
.PHONY: help start stop restart logs clean backend-dev frontend-dev install db-shell db-reset

help:           ## 显示帮助
	@echo "可用命令："
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

start:          ## 启动所有中间件
	docker compose up -d

stop:           ## 停止中间件
	docker compose down

restart:        ## 重启中间件
	docker compose restart

logs:           ## 查看中间件日志
	docker compose logs -f

install:        ## 安装依赖（后端 + 前端）
	cd backend && uv pip install -e ".[dev]" || pip install -e ".[dev]"
	cd frontend && pnpm install || npm install

backend-dev:    ## 启动后端（自动建表 + 种子）
	cd backend && cp -n .env.example .env || true && uvicorn app.main:app --reload --host 0.0.0.0 --port {{ backend_port }}

frontend-dev:   ## 启动前端
	cd frontend && pnpm dev --port {{ frontend_port }}

db-shell:       ## 进入 postgres 命令行
	docker compose exec postgres env PGPASSWORD={{ db_password }} psql -U {{ project_name }} -d {{ project_name }}

db-reset:       ## ⚠️ 重置数据库（删除所有数据）
	docker compose down -v && docker compose up -d
	@echo "✅ 数据库已重置，重启后端让其重建"

clean:          ## ⚠️ 清理所有数据
	docker compose down -v
{% else %}
# ============== server mode ==============
.PHONY: help start stop restart logs clean install backend-dev db-shell db-reset

help:           ## 显示帮助
	@echo "可用命令："
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

start:          ## 启动中间件
	docker compose up -d

stop:           ## 停止中间件
	docker compose down

restart:        ## 重启中间件
	docker compose restart

logs:           ## 查看中间件日志
	docker compose logs -f

install:        ## 安装后端依赖
	uv pip install -e ".[dev]" || pip install -e ".[dev]"

backend-dev:    ## 启动后端
	cp -n .env.example .env || true && uvicorn app.main:app --reload --host 0.0.0.0 --port {{ backend_port }}

db-shell:       ## 进入 postgres 命令行
	docker compose exec postgres env PGPASSWORD={{ db_password }} psql -U {{ project_name }} -d {{ project_name }}

db-reset:       ## ⚠️ 重置数据库（删除所有数据）
	docker compose down -v && docker compose up -d

clean:          ## ⚠️ 清理所有数据
	docker compose down -v
{% endif %}
