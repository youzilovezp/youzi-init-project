# {{ project_title }} 常用命令
# 设计原则：只保留非技术用户会用到的命令
{% if only == 'admin' %}
# ============== admin mode ==============
.PHONY: help start stop restart logs clean backend-dev frontend-dev install db-shell db-reset reset-admin backup restore

help:           ## 显示帮助
	@echo "可用命令："
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

start:          ## 启动所有中间件
	docker compose up -d

stop:           ## 停止中间件
	docker compose down

restart:        ## 重启中间件
	docker compose restart

logs:           ## 查看中间件日志
	docker compose logs -f

install:        ## 安装依赖（后端 + 前端）
	cd backend && uv pip install -e ".[dev]" || pip install -e ".[dev]"
	cd frontend && pnpm install || npm install

backend-dev:    ## 启动后端（自动建表 + 种子）
	cd backend && test -f .env || cp .env.example .env; uvicorn app.main:app --reload --host 0.0.0.0 --port {{ backend_port }}

frontend-dev:   ## 启动前端
	cd frontend && pnpm dev --port {{ frontend_port }}

db-shell:       ## 进入 postgres 命令行
	docker compose exec postgres env PGPASSWORD={{ db_password }} psql -U {{ project_name }} -d {{ project_name }}

db-reset:       ## ⚠️ 重置数据库（删除所有数据）
	docker compose down -v && docker compose up -d
	@echo "✅ 数据库已重置，重启后端让其重建"

reset-admin:    ## 重置 admin 密码（随机生成并打印）
	cd backend && python scripts/reset_admin.py

# 指定密码：make admin-pass NEW=YourPass!2025
admin-pass:     ## 重置 admin 密码为 NEW=... 指定值
	cd backend && python scripts/reset_admin.py --password "$(NEW)"

backup:         ## 备份数据库到 ./backups/
	@mkdir -p backups
	docker compose exec -T postgres env PGPASSWORD={{ db_password }} pg_dump -U {{ project_name }} > backups/backup_$$(date +%Y%m%d_%H%M%S).sql
	@echo "✅ 备份完成：backups/"

# 从备份恢复：make restore FILE=backups/backup_xxx.sql
restore:        ## 从备份恢复（FILE=backups/backup_xxx.sql）
	docker compose exec -T postgres env PGPASSWORD={{ db_password }} psql -U {{ project_name }} -d {{ project_name }} < $(FILE)

clean:          ## ⚠️ 清理所有数据
	docker compose down -v
{% else %}
# ============== server mode ==============
.PHONY: help start stop restart logs clean install backend-dev db-shell db-reset reset-admin backup restore

help:           ## 显示帮助
	@echo "可用命令："
