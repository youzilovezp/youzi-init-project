# {{ project_title }} 常用命令
# 设计原则：只保留非技术用户会用到的命令
{% if only == 'admin' %}
# =============== admin mode ===============
ENV_FILE := backend/.env
.PHONY: help start stop restart logs clean backend-dev frontend-dev install db-shell db-reset reset-admin backup restore db-migrate db-upgrade db-downgrade test test-cov

help:           ## 显示帮助
	@echo "可用命令："
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

start:          ## 启动所有中间件
	@if [ ! -f $(ENV_FILE) ]; then \
		cp $(ENV_FILE).example $(ENV_FILE); \
		echo "📝 已生成 $(ENV_FILE)，请先填 POSTGRES_PASSWORD / REDIS_PASSWORD / SECRET_KEY（生产用 openssl rand -hex 32 生成）"; \
	fi
	docker compose --env-file $(ENV_FILE) up -d

stop:           ## 停止中间件
	docker compose down

restart:        ## 重启中间件
	docker compose restart

logs:           ## 查看中间件日志
	docker compose logs -f

install:        ## 安装依赖（后端 + 前端）
	cd backend && uv pip install -e ".[dev]" || pip install -e ".[dev]"
	cd frontend && pnpm install || npm install

frontend-test:  ## 前端 vitest（覆盖 login redirect / store / router）
	cd frontend && pnpm test

backend-test:   ## 后端 pytest
	cd backend && pytest -q

backend-dev:    ## 启动后端（自动建表 + 种子）
	cd backend && (test -d .venv || uv venv .venv) && \
	(test -d .venv && . .venv/bin/activate && uv pip install -e ".[dev]" || pip install -e ".[dev]") && \
	(test -f .env || cp .env.example .env) && \
	uvicorn app.main:app --reload --host 0.0.0.0 --port {{ backend_port }}

frontend-dev:   ## 启动前端
	cd frontend && pnpm dev --port {{ frontend_port }}

db-shell:       ## 进入 postgres 命令行
	docker compose exec -T postgres env PGPASSWORD=$$POSTGRES_PASSWORD psql -U {{ project_name }} -d {{ project_name }}

# 生成迁移文件：make db-migrate msg="add order"
db-migrate:     ## 生成新迁移（msg="描述"）
	@if [ -z "$(MSG)" ]; then \
		echo "❌ 必须传 MSG: make db-migrate MSG=\"add order\""; \
		exit 1; \
	fi
	cd backend && alembic revision --autogenerate -m "$(MSG)"

# 应用所有迁移
db-upgrade:     ## 应用所有迁移到最新
	cd backend && alembic upgrade head

# 回滚一步（⚠️ 危险：会 drop 上一 migration 创建的对象）
db-downgrade:   ## 回滚最近一步迁移
	@echo "⚠️ db-downgrade 会撤销上一 migration 的所有变更（drop table / column）"
	@echo "   仅用于本地调试；生产请用备份恢复（make restore FILE=...）"
	@read -p "确认回滚? [y/N] " ans && [ "$$ans" = "y" ] || (echo "❌ 已取消"; exit 1)
	cd backend && alembic downgrade -1

db-reset:       ## ⚠️ 重置数据库（删除所有数据）
	docker compose --env-file $(ENV_FILE) down -v && docker compose --env-file $(ENV_FILE) up -d
	@echo "✅ 数据库已重置，重启后端让其重建"

reset-admin:    ## 重置 admin 密码（随机生成并打印）
	cd backend && python scripts/reset_admin.py

# 指定密码：make admin-pass NEW=YourPass!2025
admin-pass:     ## 重置 admin 密码为 NEW=... 指定值
	cd backend && python scripts/reset_admin.py --password "$(NEW)"

backup:         ## 备份数据库到 ./backups/
	@mkdir -p backups
	docker compose exec -T postgres env PGPASSWORD=$$POSTGRES_PASSWORD pg_dump -U {{ project_name }} > backups/backup_$$(date +%Y%m%d_%H%M%S).sql
	@echo "✅ 备份完成：backups/"

# 从备份恢复：make restore FILE=backups/backup_xxx.sql
restore:        ## 从备份恢复（FILE=backups/backup_xxx.sql）
	docker compose exec -T postgres env PGPASSWORD=$$POSTGRES_PASSWORD psql -U {{ project_name }} -d {{ project_name }} < $(FILE)

clean:          ## ⚠️ 清理所有数据
	docker compose down -v

test:           ## 跑后端 + 前端测试
	cd backend && pytest -q
	cd frontend && pnpm test

test-cov:       ## 生成覆盖率报告
	cd backend && pytest --cov=app --cov-report=html --cov-fail-under=70
	cd frontend && pnpm test --coverage
{% else %}
