│   ├── pyproject.toml
│   ├── .env.example
│   └── 后端说明.md
├── frontend/               # 前端（Vue 3 + TS）
│   ├── src/                # 应用代码（api/views/stores/...）
│   ├── docs/               # 架构/技术栈/配置/开发 文档
│   ├── package.json
│   ├── vite.config.ts
│   ├── tsconfig.json
│   └── .env.development
├── docker-compose.yml      # PostgreSQL/Redis（仅 DB_TYPE=postgresql 时使用）
